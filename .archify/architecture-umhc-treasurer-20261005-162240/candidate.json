  "cards": [
    {
      "dot": "rose",
      "title": "Request security",
      "items": [
        "Login: signed with the passkey; server tries admin then viewer key, 10 failures / 10 min locks login globally",
        "Every other call: HMAC over action|timestamp|canonical params with the 1h session key",
        "Writes carry a one-time nonce (cached 6 min); viewer role is limited to READ_ACTIONS",
        "\"Unauthorized\" reply clears the session and fires sessionExpired → logout"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data flow",
      "items": [
        "Views never fetch on load: App.js calls getAppData and seeds the Store",
        "Store → TransactionService swaps SOURCE rows for CHILD splits",
        "Mutations dispatch dataUploaded, which re-runs getAppData",
        "Analysis, Dashboard and Settings compute balances with financial.logic"
      ]
    },
    {
      "dot": "amber",
      "title": "Write safety (GAS)",
      "items": [
        "LockService script lock (30s) around sheet writes",
        "Split: append PENDING → stamp Finances → promote; failed phases undo",
        "Tag batch: snapshot Tags sheet, compensate Finances/Split on failure",
        "Values starting with = + - @ are prefixed with ' before writing"
      ]
    },
    {
      "dot": "slate",
      "title": "Delivery",
      "items": [
        "No npm build: Chart.js and read-excel-file vendored with SRI hashes",
        "Push to main mirrors the repo to UMHC/umhc-treasury via GitHub Actions",
        "Self-test suite loads on demand from Settings → Diagnostics"
      ]
    }
  ]
}